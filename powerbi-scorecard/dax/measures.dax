// =====================================================================
// DS Smith SSC – Balanced Scorecard | Medidas DAX para Power BI
// ---------------------------------------------------------------------
// Crea una tabla vacía "Measures" (Inicio > Escribir datos > tabla vacía)
// y añade estas medidas ahí, o pégalas sobre Fact_Scorecard.
// Modelo esperado:
//   Dim_KPI[KPI_ID]  1 --- *  Fact_Scorecard[KPI_ID]
//   Dim_Date[Date]   1 --- *  Fact_Scorecard[Date]   (marca Dim_Date como tabla de fechas)
// =====================================================================


// ---------------------------------------------------------------------
// 1) VALOR DEL KPI  (aplica la lógica según Value_Type del catálogo)
//    Numerator/Denominator se agregan con SUM, por lo que el valor es
//    correcto tanto para un mes como para cualquier periodo seleccionado
//    (los ratios se ponderan de forma natural: SUM(num)/SUM(den)).
// ---------------------------------------------------------------------
KPI Value =
VAR vt = SELECTEDVALUE ( Dim_KPI[Value_Type] )
VAR n  = SUM ( Fact_Scorecard[Numerator] )
VAR d  = SUM ( Fact_Scorecard[Denominator] )
RETURN
    SWITCH (
        vt,
        "PCT",      DIVIDE ( n, d ),
        "RATE1000", DIVIDE ( n, d ) * 1000,
        "RATIO",    DIVIDE ( n, d ),
        "CURRENCY", n,
        "COUNT",    n,
        n
    )


// ---------------------------------------------------------------------
// 2) VALOR FORMATEADO  (texto para tarjetas / tooltips, con su unidad)
// ---------------------------------------------------------------------
KPI Value (fmt) =
VAR v  = [KPI Value]
VAR vt = SELECTEDVALUE ( Dim_KPI[Value_Type] )
RETURN
    IF (
        ISBLANK ( v ),
        "–",
        SWITCH (
            vt,
            "PCT",      FORMAT ( v, "0.0%" ),
            "RATE1000", FORMAT ( v, "#,##0.0" ) & " /1k",
            "RATIO",    FORMAT ( v, "#,##0.00" ),
            "CURRENCY", FORMAT ( v, "#,##0" ) & " k€",
            "COUNT",    FORMAT ( v, "#,##0" ),
            FORMAT ( v, "#,##0.00" )
        )
    )


// ---------------------------------------------------------------------
// 3) TARGET  (valor objetivo del catálogo)
// ---------------------------------------------------------------------
KPI Target = SELECTEDVALUE ( Dim_KPI[Target] )


// ---------------------------------------------------------------------
// 4) DESVIACIÓN vs TARGET
// ---------------------------------------------------------------------
Variance to Target =
IF ( ISBLANK ( [KPI Target] ), BLANK (), [KPI Value] - [KPI Target] )

Variance % =
DIVIDE ( [KPI Value] - [KPI Target], [KPI Target] )


// ---------------------------------------------------------------------
// 5) ESTADO RAG  (Rojo / Ámbar / Verde) respetando la dirección del KPI
//    Higher (H) = más alto es mejor · Lower (L) = más bajo es mejor
//    Banda ámbar = ±5% respecto al target.
// ---------------------------------------------------------------------
RAG Status =
VAR v   = [KPI Value]
VAR t   = [KPI Target]
VAR dir = SELECTEDVALUE ( Dim_KPI[Direction] )
RETURN
    SWITCH (
        TRUE (),
        ISBLANK ( v ) || ISBLANK ( t ) || dir = "N", "No target",
        dir = "H" && v >= t,          "Green",
        dir = "H" && v >= t * 0.95,   "Amber",
        dir = "H",                    "Red",
        dir = "L" && v <= t,          "Green",
        dir = "L" && v <= t * 1.05,   "Amber",
        dir = "L",                    "Red",
        "No target"
    )

// Color hex para formato condicional (fondo de tarjeta / punto de estado)
RAG Color =
SWITCH (
    [RAG Status],
    "Green",     "#2E7D32",
    "Amber",     "#F9A825",
    "Red",       "#C62828",
    "No target", "#9E9E9E",
    "#9E9E9E"
)


// ---------------------------------------------------------------------
// 6) MES ANTERIOR y VARIACIÓN INTERMENSUAL (MoM)
//    Requiere Dim_Date marcada como tabla de fechas.
// ---------------------------------------------------------------------
KPI Value PM =
CALCULATE ( [KPI Value], DATEADD ( Dim_Date[Date], -1, MONTH ) )

MoM Change =
IF ( ISBLANK ( [KPI Value PM] ), BLANK (), [KPI Value] - [KPI Value PM] )

MoM Change % =
DIVIDE ( [KPI Value] - [KPI Value PM], [KPI Value PM] )


// ---------------------------------------------------------------------
// 7) FLECHA DE TENDENCIA  (favorable/desfavorable según dirección)
// ---------------------------------------------------------------------
Trend Arrow =
VAR delta = [KPI Value] - [KPI Value PM]
VAR dir   = SELECTEDVALUE ( Dim_KPI[Direction] )
VAR base  = [KPI Value PM]
VAR pct   = DIVIDE ( delta, ABS ( base ) )
RETURN
    SWITCH (
        TRUE (),
        ISBLANK ( [KPI Value PM] ) || ISBLANK ( [KPI Value] ), "",
        ABS ( pct ) < 0.005, "→",            // sin cambio material (<0,5%)
        delta > 0,           "↗",
        "↘"
    )

// Color de la flecha según si el movimiento es bueno o malo para el KPI
Trend Color =
VAR delta = [KPI Value] - [KPI Value PM]
VAR dir   = SELECTEDVALUE ( Dim_KPI[Direction] )
RETURN
    SWITCH (
        TRUE (),
        dir = "N" || ISBLANK ( delta ) || delta = 0, "#9E9E9E",
        ( dir = "H" && delta > 0 ) || ( dir = "L" && delta < 0 ), "#2E7D32", // favorable
        "#C62828"                                                            // desfavorable
    )


// ---------------------------------------------------------------------
// 8) YTD FISCAL  (año fiscal DS Smith: mayo–abril, campo Fiscal_Year)
// ---------------------------------------------------------------------
KPI Value YTD =
VAR fy      = SELECTEDVALUE ( Dim_Date[Fiscal_Year] )
VAR maxIdx  = MAX ( Dim_Date[Month_Index] )
RETURN
    CALCULATE (
        [KPI Value],
        REMOVEFILTERS ( Dim_Date ),
        Dim_Date[Fiscal_Year] = fy,
        Dim_Date[Month_Index] <= maxIdx
    )


// ---------------------------------------------------------------------
// 9) RESUMEN DE ESTADO  (para tarjetas KPI del panel superior)
//    Cuenta KPIs por estado en el último mes con datos del contexto.
// ---------------------------------------------------------------------
KPIs Green =
SUMX ( VALUES ( Dim_KPI[KPI_ID] ), IF ( [RAG Status] = "Green", 1, 0 ) )

KPIs Amber =
SUMX ( VALUES ( Dim_KPI[KPI_ID] ), IF ( [RAG Status] = "Amber", 1, 0 ) )

KPIs Red =
SUMX ( VALUES ( Dim_KPI[KPI_ID] ), IF ( [RAG Status] = "Red", 1, 0 ) )

KPIs Measured =
SUMX ( VALUES ( Dim_KPI[KPI_ID] ), IF ( NOT ISBLANK ( [KPI Value] ), 1, 0 ) )

% On Target =
DIVIDE ( [KPIs Green], [KPIs Green] + [KPIs Amber] + [KPIs Red] )


// ---------------------------------------------------------------------
// 10) AYUDAS DE FECHA  (para mostrar "a fecha de…" en títulos)
// ---------------------------------------------------------------------
Latest Month =
CALCULATE ( MAX ( Fact_Scorecard[Date] ), ALLSELECTED ( Dim_Date ) )

Selected Month Label =
"A fecha de " & FORMAT ( MAX ( Dim_Date[Date] ), "MMM yyyy" )
